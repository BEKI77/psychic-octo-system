# Postgres connection used by Drizzle
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/inventory_db

# NestJS HTTP port
PORT=4000

# Origin(s) allowed to call the API with credentials (comma-separated)
WEB_ORIGIN=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-hex-value
BETTER_AUTH_URL=http://localhost:4000

# Bootstrap admin created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@cylinder.local
SEED_ADMIN_PASSWORD=ChangeMe123!
